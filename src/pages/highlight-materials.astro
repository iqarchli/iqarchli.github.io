---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudySection from "../components/CaseStudySection.astro";
import CaseStudyFigure from "../components/CaseStudyFigure.astro";
import { siteConfig } from "../config";

const img = (name: string) => `/case-studies/highlight-materials/${name}.jpg`;

const tags = ["User research", "Usability testing", "Desktop", "Enscape"];

const facts = [
  { label: "Product", value: "Enscape" },
  { label: "Feature", value: "White Mode overrides" },
  { label: "Research", value: "Usability test, 4 participants" },
  { label: "Timeline", value: "2 sprints · 4 weeks" },
];

const tasks = [
  { title: "Exclude categories", body: "Exclude general categories, such as vegetation or vehicles, from White Mode." },
  { title: "Exclude elements", body: "Exclude specific elements of the scene from White Mode." },
  { title: "Invert", body: "Invert the appearance, so that only the selected elements are shown in white." },
];

const participants = [
  "Architect, Interior Architect",
  "Architect, 3D Artist",
  "Architect & Team lead",
  "Architect & Interior Designer",
];

const findings = [
  {
    task: "General structure",
    good: "Participants recognized the categories from their icons alone. The UI was user friendly and error tolerant, so mistakes were easy to undo.",
    bad: "The custom settings felt detached from White Mode, because the Outlines slider sat between the mode dropdown and the overrides. Participants were also worried about filling the main tab with White Mode settings, and Rendering Quality was pushed so far down that they had to scroll to find it.",
  },
  {
    task: "Excluding categories",
    good: "No participant missed a category, so the list seems to cover most of what users need. The task was easy to understand and to perform.",
    bad: "It wasn't clear whether the categories also include the custom categories that designers define for their own assets. Listing all materials of the project wouldn't help either, since users rarely give their materials proper names.",
  },
  {
    task: "Excluding specific elements",
    good: "Once participants started, the task was quick, with few steps and a clear purpose.",
    bad: "Before trying it, participants didn't understand what the Individual Assets section was for. There was also no way to pick several assets from the scene at once, which matters in scenes with many objects.",
  },
  {
    task: "Inverting the appearance",
    good: "Straightforward to use. Once participants understood the basics, everything made sense.",
    bad: "The tooltip didn't explain what Invert Appearance does, so its description had to be rewritten.",
  },
];

const changes = [
  "The White Mode overrides now sit directly under the mode, so they no longer feel detached from it.",
  "Outlines and Rendering Quality are no longer hidden when the overrides are open.",
  "The materials section was removed to save space. Materials can still be found with search, and most users prefer to pick them in the scene anyway.",
  "The site context option was removed, since it wasn't a priority for users.",
  "Labels and tooltips were rewritten to explain what each option does before users try it.",
  "A reset option brings all settings back to their defaults.",
];
---

<BaseLayout
  title={`Highlighting Key Materials in 3D Renderings - ${siteConfig.name}`}
  description="UX case study: letting users exclude materials and objects from Enscape's White Mode, tested with architects."
>
  <main class="pt-8 md:pt-20">
    <!-- Intro -->
    <section class="px-8 sm:px-12 md:px-16 lg:px-24 pt-8 pb-12 sm:pb-16">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to projects
      </a>

      <div class="mt-8">
        <span class="text-sm font-mono" style={{ color: siteConfig.accentColor }}>
          Case study · Enscape
        </span>
        <h1 class="mt-2 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-900">
          Highlighting Key Materials in 3D Renderings
        </h1>
        <div
          class="w-[75px] h-[5px] mt-3 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
        <p class="mt-6 text-lg sm:text-xl text-gray-600 leading-relaxed">
          When users switch a rendering to White Mode, they often still want to show the colours and materials of certain
          objects. This feature lets them exclude materials and objects from White Mode, so they can highlight exactly the
          parts of a scene they want their clients to focus on.
        </p>
        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-6">
          {
            tags.map((tag) => (
              <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <dl class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          facts.map((fact) => (
            <div class="p-4 sm:p-5 bg-gray-50 rounded-xl border border-gray-200">
              <dt class="text-xs sm:text-sm text-gray-500">{fact.label}</dt>
              <dd class="mt-1 text-sm sm:text-base font-semibold text-gray-900">{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10">
        <CaseStudyFigure
          src={img("white-mode")}
          size="medium"
          alt="An urban scene under an elevated walkway, rendered entirely in White Mode"
          caption="A scene in White Mode. Everything is white, including the elements that should stand out."
        />
      </div>
    </section>

    <CaseStudySection id="problem" label="01" title="The problem">
      <p>
        White Mode renders a whole scene in white. Architects use it to show the shape of a design without distracting
        details, especially when a project is still in progress. But some objects should keep their colours: a facade
        material that has already been chosen, or the people and cars that give the scene a sense of scale.
      </p>
      <p>
        Until then, White Mode was all or nothing. I designed a way for users to exclude materials and objects from it,
        and after the concept phases I tested the UI with volunteers from our user group.
      </p>
      <blockquote
        class="p-4 sm:p-6 bg-gray-50 rounded-xl sm:rounded-2xl border-l-4 text-gray-900 text-lg sm:text-xl leading-relaxed"
        style={`border-color: ${siteConfig.accentColor}`}
      >
        “As an architect, I often present the project to my clients in different states of progress. That also means that
        not everything is done or well defined. The client should focus on the things that are defined and not be
        distracted by details that don't matter.”
      </blockquote>
    </CaseStudySection>

    <CaseStudySection id="design" label="02" title="The design">
      <p>
        The overrides live in the Visual Settings, right below the White Mode option. They work on two levels. Asset
        Categories exclude whole groups, such as vegetation, people or vehicles, with one checkbox each. Individual Assets
        lets users pick specific objects, either by searching for them or by selecting them directly in the scene.
      </p>
      <div class="grid sm:grid-cols-2 gap-6 items-start">
        <CaseStudyFigure
          src={img("before-selection")}
          alt="The White Mode overrides with no categories checked and an empty Individual Assets list reading 'No selected objects, yet'"
          caption="Before selection: the empty list explains what's missing and offers the pick button."
        />
        <CaseStudyFigure
          src={img("after-selection")}
          alt="The same panel with three categories checked and a list of picked assets such as armchairs, trees, people and cars, each with a remove button"
          caption="After selection: each picked asset appears as a chip that can be removed."
        />
      </div>
      <p>
        An Invert Appearance toggle reverses the logic. Instead of excluding a few objects from White Mode, users can show
        only the selected objects in white, which is quicker when most of the scene should keep its materials.
      </p>
    </CaseStudySection>

    <CaseStudySection id="testing" label="03" title="Testing the design">
      <p>
        I tested the prototype with four participants who present 3D work to clients in their daily work. Each
        participant worked through three tasks and described what they expected before and after each step.
      </p>
      <div class="grid sm:grid-cols-3 gap-4">
        {
          tasks.map((t, i) => (
            <div class="p-4 sm:p-5 bg-gray-50 rounded-xl border border-gray-200">
              <span class="text-sm font-mono" style={{ color: siteConfig.accentColor }}>
                Task {i + 1}
              </span>
              <p class="mt-1 font-semibold text-gray-900">{t.title}</p>
              <p class="mt-1 text-sm sm:text-base">{t.body}</p>
            </div>
          ))
        }
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-gray-900">Participants</h3>
      <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 list-disc pl-5">
        {participants.map((p) => <li>{p}</li>)}
      </ul>
    </CaseStudySection>

    <CaseStudySection id="findings" label="04" title="Findings">
      <p>
        Overall, participants found the feature easy to use once they understood it. Most problems came from where the
        settings were placed and from labels that didn't explain enough.
      </p>
      <div class="space-y-4">
        {
          findings.map((f) => (
            <div class="p-4 sm:p-6 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900">{f.task}</h3>
              <div class="mt-3 grid sm:grid-cols-2 gap-4 text-sm sm:text-base">
                <div>
                  <p class="text-xs font-mono uppercase tracking-wide" style={{ color: siteConfig.accentColor }}>
                    What worked
                  </p>
                  <p class="mt-1 text-gray-700">{f.good}</p>
                </div>
                <div>
                  <p class="text-xs font-mono uppercase tracking-wide text-gray-400">What didn't</p>
                  <p class="mt-1">{f.bad}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </CaseStudySection>

    <CaseStudySection id="changes" label="05" title="What I changed">
      <p>Based on the findings, I suggested these changes for the next version of the UI:</p>
      <ul class="space-y-3 list-disc pl-5">
        {changes.map((c) => <li>{c}</li>)}
      </ul>
      <div class="pt-4">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 hover:bg-gray-700 text-white rounded-lg text-sm font-medium transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back to projects
        </a>
      </div>
    </CaseStudySection>
  </main>
</BaseLayout>
