---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  size?: "narrow" | "medium" | "large";
}

const { src, alt, caption, size } = Astro.props;

const sizeClass = {
  narrow: "max-w-[200px] sm:max-w-[240px] mx-auto",
  medium: "max-w-xl mx-auto",
  large: "max-w-3xl mx-auto",
};
---

<figure class:list={["space-y-3", size && sizeClass[size]]}>
  <a
    href={src}
    target="_blank"
    rel="noopener noreferrer"
    class="block overflow-hidden rounded-xl sm:rounded-2xl border border-gray-200 bg-gray-900 transition-all duration-300 hover:shadow-xl hover:border-gray-300"
  >
    <img src={src} alt={alt} loading="lazy" class="w-full h-auto" />
  </a>
  {caption && <figcaption class="text-sm text-gray-500 leading-relaxed">{caption}</figcaption>}
</figure>
